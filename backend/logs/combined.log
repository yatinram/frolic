[2026-09-07 11:25:11] [DEBUG]: Executing (default): INSERT INTO `programs` (`id`,`name`,`slug`,`ageGroup`,`tagline`,`category`,`accentColor`,`icon`,`shortDescription`,`features`,`syllabusContent`,`sortOrder`,`isActive`,`createdAt`,`updatedAt`) VALUES (NULL,'Play Group','play-group','1.5 – 2.5 Years','Play, Wonder & Discover','Preschool','#E8453C','SmileOutlined','A joyful sensory beginning where toddlers build confidence, motor skills, and social curiosity through guided play.','[\"Sensory Play Stations\",\"Music & Rhyme Circle\",\"Social & Emotional Readiness\",\"Fine Motor Development\"]','[]',1,true,'2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'Nursery','nursery','2.5 – 3.5 Years','Phonics, Numbers & Creative Wonder','Preschool','#4CAF3D','ReadOutlined','Foundational literacy and numeracy through experiential play, story circles, and interactive discovery labs.','[\"Phonics & Letter Sounds\",\"Concept Numeracy & Sorting\",\"Theme-Based EVS Exploration\",\"Expressive Art & Craft\"]','[]',2,true,'2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'LKG (Lower Kindergarten)','lkg','3.5 – 4.5 Years','Interactive English Lab & Maths Lab Integration','Preschool','#2E9BD6','BookOutlined','Stepping into early digital labs with D.I.E.L. phonemes, Pabulum workbooks, and interactive abacus foundations.','[\"Digital English Lab (DIEL)\",\"Abacus Visual Numeracy\",\"Sight Words & Sentence Building\",\"Critical Thinking Exercises\"]','[]',3,true,'2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'UKG (Upper Kindergarten)','ukg','4.5 – 5.5 Years','Primary School Readiness & Advanced Lab Modules','Preschool','#F5821F','RocketOutlined','Mastering reading comprehension, rapid mental arithmetic, public speaking, and seamless transition to Grade 1.','[\"Reading Fluency & Stories\",\"Mental Arithmetic with Abacus\",\"Creative Writing & Compositions\",\"Scientific Inquiry & Projects\"]','[]',4,true,'2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'Frolic Digital English Lab (D.I.E.L.)','english-lab','K.G. to Class 5','8000+ Vocabulary Words • 25000+ Practiced Sentences','English Lab','#2E9BD6','TranslationOutlined','Digital Interactive English Lab developed in collaboration with Manovikas Mulyankan Sanstha & Pabulum® Workbooks.','[\"44 Phonemes & Graphemes\",\"150+ Audio-Visual Stories\",\"200+ Guided Compositions\",\"25,000+ Oral Sentence Practices\",\"Periodic Digital Parent Reports\"]','[]',5,true,'2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'Frolic Digital Maths Lab','maths-lab','K.G. to Class 5','Abacus Integrated • Dual-Brain Cognitive Mastery','Maths Lab','#FDB913','CalculatorOutlined','Combines hands-on physical abacus movement with interactive digital challenges to develop lightning-fast mental math.','[\"Dual-Hemisphere Brain Stimulation\",\"3 Structured Mathematical Echelons\",\"Pragmatic Geometry & Money Lab\",\"Visual Problem Solving\"]','[]',6,true,'2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'Frolic Teacher Mentoring Program','teacher-training','Educators & Franchise Staff','12-Module Mentoring Program aligned with NEP 2020 & NCF 2023','Teacher Training','#7B2D8B','TeamOutlined','Authored by Gaurang Oza, equipping educators with modern child psychology, play-based strategies, and technology integration.','[\"NEP 2020 & NCF 2023 Alignment\",\"Child-Centred Assessment Methods\",\"Classroom & Digital Lab Management\",\"Continuous Reflective Practice\"]','[]',7,true,'2026-09-07 05:55:11','2026-09-07 05:55:11');
