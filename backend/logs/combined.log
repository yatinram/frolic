[2026-09-07 11:25:11] [DEBUG]: Executing (default): INSERT INTO `testimonials` (`id`,`name`,`role`,`childName`,`program`,`rating`,`quote`,`isPublished`,`sortOrder`,`createdAt`,`updatedAt`) VALUES (NULL,'Pooja & Jignesh Patel','Parent of Aarav (UKG)','Aarav Patel','UKG & English Lab',5,'Frolic is not a typical preschool; it is truly an educational lab! Aarav started reading English storybooks independently at age 5. The DIEL digital software and Pabulum workbooks made a tremendous difference.',true,1,'2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'Meghna Shah','Parent of Ananya (LKG)','Ananya Shah','LKG & Maths Lab',5,'The Maths Lab with abacus has given Ananya incredible confidence in numbers. She visualizes beads and calculates mentally faster than we expected. Outstanding teaching methodology!',true,2,'2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'Dr. Hardik Vyas','Franchise Partner, Gandhinagar Center',NULL,'Franchise Owner',5,'Partnering with Frolic Education was the best decision. The curriculum backing from Manovikas Mulyankan Sanstha, comprehensive teacher training, and complete branding support made center operations seamless.',true,3,'2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'Ritu & Sanjay Sharma','Parent of Kabir (Nursery)','Kabir Sharma','Nursery',5,'The warmth and safety at Frolic Gandhinagar gave us immense peace of mind. Kabir loves the sensory activities and looks forward to going to school every single morning!',true,4,'2026-09-07 05:55:11','2026-09-07 05:55:11');
