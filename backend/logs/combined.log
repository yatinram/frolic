[2026-09-07 11:25:11] [DEBUG]: Executing (default): INSERT INTO `media_gallery` (`id`,`title`,`imageUrl`,`category`,`altText`,`sortOrder`,`isFeatured`,`createdAt`,`updatedAt`) VALUES (NULL,'Official Student Uniform & Kit','/assets/kits.jpeg','kits','Frolic Kids Edu Labs official student bag, cap, polo, apron, jeans, and socks',1,true,'2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'Interactive English Lab Session','https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=800&auto=format&fit=crop','classroom','Students engaged in interactive digital listening and reading practice',2,true,'2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'Abacus Maths Lab in Action','https://images.unsplash.com/photo-1509062522246-3755977927d7?w=800&auto=format&fit=crop','activities','Children working on mental mathematics and counting beads',3,true,'2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'Creative Art & Sensory Play','https://images.unsplash.com/photo-1544717305-2782549b5136?w=800&auto=format&fit=crop','activities','Toddlers painting and exploring tactile materials',4,true,'2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'Annual Day Celebrations & Graduation','https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=800&auto=format&fit=crop','events','Frolic annual performance and student awards ceremony',5,true,'2026-09-07 05:55:11','2026-09-07 05:55:11');
[2026-09-07 11:25:11] [INFO]: ✅ Initial Media Gallery seeded
[2026-09-07 11:25:11] [DEBUG]: Executing (default): SELECT count(*) AS `count` FROM `blogs` AS `Blog`;
[2026-09-07 11:25:11] [DEBUG]: Executing (default): INSERT INTO `blogs` (`id`,`title`,`slug`,`summary`,`content`,`coverImage`,`author`,`category`,`readTime`,`isPublished`,`publishedAt`,`createdAt`,`updatedAt`) VALUES (NULL,'Why Digital Interactive Learning Works for Preschoolers','why-digital-interactive-learning-works-for-preschoolers','Explore how multi-sensory interactive education outperforms passive screen time and traditional rote learning in early childhood.','\n            <p>In today\'s fast-evolving world, early childhood education is undergoing a fundamental transformation. Rather than relying solely on passive blackboard instruction or rote memorization, leading educational research emphasizes <strong>multi-sensory interactive experiences</strong>.</p>\n            <h3>1. Active vs Passive Engagement</h3>\n            <p>Traditional rote learning often leaves young minds disengaged. When children interact with tactile materials, responsive digital phonetics, and colorful contextual challenges, neural pathways associated with linguistic and logical retention fire much more effectively.</p>\n            <h3>2. The Science of Phonemic Awareness</h3>\n            <p>At Frolic Kids Edu Labs, our English Lab introduces 44 phonemes through Digital Interactive Oral Exercises (D.I.E.L.). Children learn to associate smallest units of sound with visual graphemes, accelerating sight-word recognition and reading speed.</p>\n            <h3>3. Confidence through Non-Judgmental Learning</h3>\n            <p>Children learn best when freed from the fear of making mistakes. Interactive labs allow children to retry exercises at their personal pace until mastery is attained, fostering high self-esteem and a lifelong love for learning.</p>\n          ','https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=800','Frolic Edu Team','Pedagogy','4 min read',true,'2026-09-07 05:55:11','2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'Play Group vs Nursery vs LKG — What is the Difference?','play-group-vs-nursery-vs-lkg-difference','A comprehensive age-wise milestone roadmap for parents seeking the right starting point for their little learner.','\n            <p>Choosing the right preschool program for your toddler is one of the most critical foundational decisions parents make. Here is how developmental milestones map to each program stage:</p>\n            <h3>Play Group (Ages 1.5 – 2.5 Years)</h3>\n            <p>Focused on separation comfort, sensory stimulation, basic vocabulary through songs, and fine/gross motor coordination through structured play.</p>\n            <h3>Nursery (Ages 2.5 – 3.5 Years)</h3>\n            <p>Introduction to phonics, numerical grouping, color recognition, structured routines, and social-emotional cooperative interaction.</p>\n            <h3>LKG & UKG (Ages 3.5 – 5.5 Years)</h3>\n            <p>Integration of structured English & Maths Labs, reading short stories, mental arithmetic, and holistic preparation for primary schooling.</p>\n          ','https://images.unsplash.com/photo-1587654780291-39c9404d746b?w=800','Frolic Edu Team','Parenting Guide','5 min read',true,'2026-09-07 05:55:11','2026-09-07 05:55:11','2026-09-07 05:55:11'),(NULL,'The Dual-Brain Benefit of Abacus-Integrated Maths Labs','dual-brain-benefit-abacus-maths-labs','How combining physical bead movement with mental visualization stimulates both left and right cerebral hemispheres.','\n            <p>Mathematics is often feared when taught merely as abstract symbols on paper. When young children use an abacus, numerical concepts transform into tangible, visual, and spatial entities.</p>\n            <p>While the left brain computes logical sequencing and arithmetic rules, the right brain visualizes the beads and patterns. This dual-brain synchronization enhances photographic memory, concentration, and rapid mental math capabilities.</p>\n          ','https://images.unsplash.com/photo-1509062522246-3755977927d7?w=800','Frolic Edu Team','Cognitive Science','4 min read',true,'2026-09-07 05:55:11','2026-09-07 05:55:11','2026-09-07 05:55:11');
