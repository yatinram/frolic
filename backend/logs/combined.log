[2026-09-27 09:06:30] [DEBUG]: Executing (default): INSERT INTO `media_gallery` (`id`,`title`,`imageUrl`,`category`,`altText`,`sortOrder`,`isFeatured`,`createdAt`,`updatedAt`) VALUES (NULL,'Official Student Uniform & Kit','/assets/kits.jpeg','kits','Frolic Kids Edu Labs official student bag, cap, polo, apron, jeans, and socks',1,true,'2026-09-27 03:36:30','2026-09-27 03:36:30'),(NULL,'Interactive English Lab Session','https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=800&auto=format&fit=crop','classroom','Students engaged in interactive digital listening and reading practice',2,true,'2026-09-27 03:36:30','2026-09-27 03:36:30'),(NULL,'Abacus Maths Lab in Action','https://images.unsplash.com/photo-1509062522246-3755977927d7?w=800&auto=format&fit=crop','activities','Children working on mental mathematics and counting beads',3,true,'2026-09-27 03:36:30','2026-09-27 03:36:30'),(NULL,'Creative Art & Sensory Play','https://images.unsplash.com/photo-1544717305-2782549b5136?w=800&auto=format&fit=crop','activities','Toddlers painting and exploring tactile materials',4,true,'2026-09-27 03:36:30','2026-09-27 03:36:30'),(NULL,'Annual Day Celebrations & Graduation','https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=800&auto=format&fit=crop','events','Frolic annual performance and student awards ceremony',5,true,'2026-09-27 03:36:30','2026-09-27 03:36:30');
